# Copiază fișierul ca `.env` și completează valorile.
DATABASE_URL=postgresql+psycopg://postgres:PAROLA@localhost:5432/patronette
TEST_DATABASE_URL=postgresql+psycopg://postgres:PAROLA@localhost:5432/patronette_test
# Cel puțin 32 de caractere aleatorii, de exemplu:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ID-urile de client OAuth Google (Android, web), separate prin virgulă.
GOOGLE_CLIENT_IDS=
# E-mailurile administratoarelor (moderare), separate prin virgulă.
ADMIN_EMAILS=
CORS_ORIGINS=*
